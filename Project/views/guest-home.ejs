<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>FoodDelivery - Welcome</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/guestHome.css">
</head>

<body>
    <!-- Guest Navbar -->
    <nav class="guest-nav">
        <div class="logo">FoodDelivery</div>
        <ul class="guest-nav-links">
            <li>
                <a href="/auth/login" class="login-link">
                    Login <i class="fas fa-sign-in-alt"></i>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Banner -->
    <div class="guest-banner">
        <div class="banner-content">
            <h1>Delicious Food, Delivered Fast</h1>
            <p>Order from your favorite restaurants and have it delivered straight to your door. Sign up now to start
                ordering!</p>
            <a href="/auth/login" class="login-btn">
                <i class="fas fa-user"></i> Login or Sign Up
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="dashboard-container">
        <h2>Explore Our Menu</h2>
        <p>Browse our delicious offerings. Login to place an order!</p>

        <!-- Food List -->
        <div class="food-list" id="food-list">
            <% foods.forEach(food=> { if (food.available) { %>
                <div class="food-item">
                    <h3>
                        <%= food.name %>
                    </h3>
                    <p>
                        <%= food.restaurant %>
                    </p>
                    <p>Price: $<%= food.price %>
                    </p>
                    <button class="disabled-btn" onclick="showLoginPrompt()">
                        Add to Cart
                    </button>
                </div>
                <% } }) %>
        </div>

        <!-- Services -->
        <div class="service-info">
            <h3>Our Services</h3>
            <p>We deliver food from top restaurants right to your doorstep. Choose from a variety of cuisines and enjoy
                fast and reliable delivery.</p>
        </div>

        <!-- Stats -->
        <div class="stats">
            <div class="card">
                <i class="fas fa-utensils"></i>
                <h4>500+</h4>
                <p>Restaurants</p>
            </div>
            <div class="card">
                <i class="fas fa-truck"></i>
                <h4>10,000+</h4>
                <p>Orders Delivered</p>
            </div>
            <div class="card">
                <i class="fas fa-user"></i>
                <h4>50,000+</h4>
                <p>Happy Customers</p>
            </div>
        </div>
    </div>

    <!-- Modal for login prompt -->
    <div class="modal" id="login-prompt-modal">
        <div class="modal-content" style="text-align:center; padding:40px;">
            <span class="close-modal" onclick="closeLoginPrompt()">&times;</span>
            <i class="fas fa-lock" style="font-size: 48px; color: #ff5722; margin-bottom: 20px;"></i>
            <h2>Login Required</h2>
            <p>Please login or create an account to add items to your cart and place orders.</p>
            <a href="/auth/login" class="login-btn" style="margin-top: 20px;">
                <i class="fas fa-sign-in-alt"></i> Login Now
            </a>
        </div>
    </div>
    <br><br>

    <!-- Footer -->
    <footer class="footer">
        <p>&copy; 2025 FoodDelivery. All rights reserved.</p>
    </footer>

    <script>
        // Function to show login prompt modal
        function showLoginPrompt() {
            document.getElementById('login-prompt-modal').style.display = 'flex';
        }

        // Function to close login prompt modal
        function closeLoginPrompt() {
            document.getElementById('login-prompt-modal').style.display = 'none';
        }

        // Close modal when clicking outside of it
        window.addEventListener('click', (event) => {
            const modal = document.getElementById('login-prompt-modal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    </script>
</body>

</html>